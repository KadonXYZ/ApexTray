<Window x:Class="ApexTray.KeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ApexTray"
        Title="{l:T 'Keyboard shortcut'}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock Text="{l:T 'Press the key or key combination'}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"
                   Text="{l:T 'Up to 3 keys including modifiers, e.g. Ctrl + Shift + T. The mouse sends it like a keyboard would.'}" />
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Height="52">
            <TextBlock x:Name="ComboText" Text="{l:T 'Waiting for keys...'}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:T 'Clear'}" Click="Clear_Click" Margin="0,0,8,0" Focusable="False" />
            <Button Content="{l:T 'Cancel'}" Click="Cancel_Click" Margin="0,0,8,0" Focusable="False" />
            <Button x:Name="OkButton" Content="{l:T 'Assign'}" Style="{StaticResource Primary}" Click="Ok_Click" IsEnabled="False" Focusable="False" />
        </StackPanel>
    </StackPanel>
</Window>
